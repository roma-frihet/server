# 이 파일을 복사해 .env 로 만들고 값을 채운다. (.env 는 git에 올리지 않는다)

# --- DB (Supabase Postgres) ---
# 로컬 Supabase(npx supabase start) 기본값: jdbc:postgresql://localhost:54322/postgres, postgres / postgres
# 원격 Supabase: Project Settings > Database > Connection string
#   - Direct connection 또는 Session pooler(포트 5432)를 쓴다.
#   - Transaction pooler(포트 6543)를 써야 한다면 URL 끝에 ?prepareThreshold=0 을 붙인다.
DB_URL=jdbc:postgresql://localhost:54322/postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Supabase Auth (JWT 검증) ---
# 로컬: http://127.0.0.1:54321 / 원격: https://<project-ref>.supabase.co
SUPABASE_URL=http://127.0.0.1:54321
# 비워 두면 JWKS(비대칭 키)로 검증한다. 로컬 Supabase는 ES256이므로 비워 둔다.
# 원격 프로젝트가 레거시 HS256 JWT secret 방식일 때만 값을 넣는다.
SUPABASE_JWT_SECRET=

# --- Supabase Storage (문제 이미지) ---
# 서버 전용 키다. 프론트엔드로 보내지 않는다. question-images 버킷은 Private으로 Studio나 대시보드에서 만든다.
# 로컬: npx supabase status -o env 의 SERVICE_ROLE_KEY 값을 넣는다.
SUPABASE_SERVICE_ROLE_KEY=
