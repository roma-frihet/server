# 이 파일을 복사해 .env 로 만들고 값을 채운다. (.env 는 git에 올리지 않는다)

# --- DB (Supabase Postgres) ---
# 로컬 Supabase(supabase start) 기본값: jdbc:postgresql://localhost:54322/postgres, postgres / postgres
# 원격 Supabase: Project Settings > Database > Connection string
#   - Direct connection 또는 Session pooler(포트 5432)를 쓴다.
#   - Transaction pooler(포트 6543)를 써야 한다면 URL 끝에 ?prepareThreshold=0 을 붙인다.
DB_URL=jdbc:postgresql://localhost:54322/postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Supabase Auth (JWT 검증) ---
# 로컬: http://127.0.0.1:54321 / 원격: https://<project-ref>.supabase.co
SUPABASE_URL=http://127.0.0.1:54321
# 프로젝트가 레거시 HS256 JWT secret 방식이면 값을 넣는다. 비워 두면 JWKS(비대칭 키)로 검증한다.
SUPABASE_JWT_SECRET=
